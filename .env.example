# Copy this file to `.env` (git-ignored) and fill in real values. Never commit `.env`.

# Postgres connection string for dbmate migrations.
# Supabase dashboard → your project → Connect → "Session pooler" URI (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password from your password manager.
# Point this at tcg-dev while developing. Only switch to tcg-prod deliberately.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"
